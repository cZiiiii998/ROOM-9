  endingText: {fileID: 457904221}
  continueText: {fileID: 1244568660}
  restartSceneName: S10_Corridor
  mainMenuSceneName: 
  upEndingText: 'You climbed upward and kept walking.



    At the end of the stairs,
    the cold light finally gave way to open air.



    You escaped.



    You are
    free.'
  downEndingText: 'You walked downward for what felt like forever.



    The darkness
    never seemed to end.



    And then, slowly, a familiar shape appeared before
    you.



    A corridor exactly like the one above.'
  continuePrompt: Press any key to continue
  fadeDuration: 1.2
  typewriterSpeed: 0.03
  continuePromptDelay: 0.3
  maxPanelAlpha: 0.9
