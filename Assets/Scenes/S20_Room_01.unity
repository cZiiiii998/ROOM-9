  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 120359041554917552, guid: 203484d5888c16e46a9930e46ad0bbaf, type: 3}
      propertyPath: noteText
      value: 'If you''re already in, then don''t even think about going back the
        way you came.


        The light won''t stay on.

        But the moment
        it appears - it already tells you the answer.


        Don''t try to guess
        with your instincts. Memorize them.The order doesn''t matter, but you have
        to see every change.


        ...... Don''t make a mistake.

        You
        won''t be given too many chances here.'
